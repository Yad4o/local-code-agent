{
  "title": "Todo UI",
  "test_command": "python -m pytest -q",
  "steps": [
    {
      "title": "render_button makes a small form with one button",
      "description": "Create render_button(action, task_id, label) in todo/ui_button.py. It returns the HTML of a small form with one button that posts the task id to /action.\n1. opening = \"<form method='post' action='/\" + action + \"'>\"\n2. hidden = \"<input type='hidden' name='id' value='\" + str(task_id) + \"'>\"\n3. return opening + hidden + \"<button>\" + label + \"</button></form>\"\n",
      "commit": "feat: add render_button",
      "tests": [
        "tests/test_ui_button.py"
      ],
      "files": [
        "todo/__init__.py",
        "todo/ui_button.py"
      ],
      "function": "todo.ui_button:render_button",
      "signature": "render_button(action, task_id, label)",
      "examples": [
        {
          "args": [
            "done",
            3,
            "Done"
          ],
          "expect": "<form method='post' action='/done'><input type='hidden' name='id' value='3'><button>Done</button></form>"
        },
        {
          "args": [
            "remove",
            12,
            "Remove"
          ],
          "expect": "<form method='post' action='/remove'><input type='hidden' name='id' value='12'><button>Remove</button></form>"
        }
      ]
    },
    {
      "title": "render_task shows one task as a list item",
      "description": "Create render_task(task) in todo/ui_task.py. Use render_button from todo/ui_button.py (already written, shown below). Each task is a dict {\"id\", \"text\", \"done\"}, for example {\"id\": 1, \"text\": \"milk\", \"done\": False}. It returns one list item: the text is escaped so it cannot inject HTML, and a done task is struck through.\n1. import html\n2. label = html.escape(task[\"text\"])\n3. if task[\"done\"]: label = \"<s>\" + label + \"</s>\"\n4. done_button = render_button(\"done\", task[\"id\"], \"Done\")\n5. remove_button = render_button(\"remove\", task[\"id\"], \"Remove\")\n6. return \"<li>\" + label + \" \" + done_button + \" \" + remove_button + \"</li>\"\n",
      "commit": "feat: add render_task",
      "tests": [
        "tests/test_ui_task.py"
      ],
      "files": [
        "todo/__init__.py",
        "todo/ui_task.py"
      ],
      "context": [
        "todo/ui_button.py"
      ],
      "function": "todo.ui_task:render_task",
      "signature": "render_task(task)",
      "examples": [
        {
          "args": [
            {
              "id": 1,
              "text": "milk",
              "done": false
            }
          ],
          "expect": "<li>milk <form method='post' action='/done'><input type='hidden' name='id' value='1'><button>Done</button></form> <form method='post' action='/remove'><input type='hidden' name='id' value='1'><button>Remove</button></form></li>"
        },
        {
          "args": [
            {
              "id": 2,
              "text": "eggs",
              "done": true
            }
          ],
          "expect": "<li><s>eggs</s> <form method='post' action='/done'><input type='hidden' name='id' value='2'><button>Done</button></form> <form method='post' action='/remove'><input type='hidden' name='id' value='2'><button>Remove</button></form></li>"
        },
        {
          "args": [
            {
              "id": 3,
              "text": "<b>x</b>",
              "done": false
            }
          ],
          "expect": "<li>&lt;b&gt;x&lt;/b&gt; <form method='post' action='/done'><input type='hidden' name='id' value='3'><button>Done</button></form> <form method='post' action='/remove'><input type='hidden' name='id' value='3'><button>Remove</button></form></li>"
        }
      ]
    },
    {
      "title": "render_list shows all tasks as a list",
      "description": "Create render_list(tasks) in todo/ui_list.py. Use render_task from todo/ui_task.py (already written, shown below). tasks is a list of task dicts. Each task is a dict {\"id\", \"text\", \"done\"}, for example {\"id\": 1, \"text\": \"milk\", \"done\": False}.\n1. if len(tasks) == 0: return \"<p>No tasks yet.</p>\"\n2. rows = \"\"\n3. For each task in tasks:\n   - rows = rows + render_task(task)\n4. return \"<ul>\" + rows + \"</ul>\"\n",
      "commit": "feat: add render_list",
      "tests": [
        "tests/test_ui_list.py"
      ],
      "files": [
        "todo/__init__.py",
        "todo/ui_list.py"
      ],
      "context": [
        "todo/ui_task.py"
      ],
      "function": "todo.ui_list:render_list",
      "signature": "render_list(tasks)",
      "examples": [
        {
          "args": [
            []
          ],
          "expect": "<p>No tasks yet.</p>"
        },
        {
          "args": [
            [
              {
                "id": 1,
                "text": "milk",
                "done": false
              }
            ]
          ],
          "expect": "<ul><li>milk <form method='post' action='/done'><input type='hidden' name='id' value='1'><button>Done</button></form> <form method='post' action='/remove'><input type='hidden' name='id' value='1'><button>Remove</button></form></li></ul>"
        },
        {
          "args": [
            [
              {
                "id": 1,
                "text": "milk",
                "done": false
              },
              {
                "id": 2,
                "text": "eggs",
                "done": true
              }
            ]
          ],
          "expect": "<ul><li>milk <form method='post' action='/done'><input type='hidden' name='id' value='1'><button>Done</button></form> <form method='post' action='/remove'><input type='hidden' name='id' value='1'><button>Remove</button></form></li><li><s>eggs</s> <form method='post' action='/done'><input type='hidden' name='id' value='2'><button>Done</button></form> <form method='post' action='/remove'><input type='hidden' name='id' value='2'><button>Remove</button></form></li></ul>"
        }
      ]
    },
    {
      "title": "render_page builds the whole page",
      "description": "Create render_page(tasks) in todo/ui_page.py. Use summarize from todo/summary.py and render_list from todo/ui_list.py (already written, shown below). tasks is a list of task dicts. Each task is a dict {\"id\", \"text\", \"done\"}, for example {\"id\": 1, \"text\": \"milk\", \"done\": False}. It returns the whole HTML page: the title, a small style so the buttons sit on one line, the summary line, a form to add a task, then the list.\n1. summary = summarize(tasks)\n2. form = \"<form method='post' action='/add'><input name='text' placeholder='new task' required><button>Add</button></form>\"\n3. head = \"<!doctype html><meta charset='utf-8'><title>Todo</title><style>form{display:inline}li{margin:6px 0}</style><h1>Todo</h1>\"\n4. return head + \"<p>\" + summary + \"</p>\" + form + render_list(tasks)\n",
      "commit": "feat: add render_page",
      "tests": [
        "tests/test_ui_page.py"
      ],
      "files": [
        "todo/__init__.py",
        "todo/ui_page.py"
      ],
      "context": [
        "todo/summary.py",
        "todo/ui_list.py"
      ],
      "function": "todo.ui_page:render_page",
      "signature": "render_page(tasks)",
      "examples": [
        {
          "args": [
            []
          ],
          "expect": "<!doctype html><meta charset='utf-8'><title>Todo</title><style>form{display:inline}li{margin:6px 0}</style><h1>Todo</h1><p>0 open, 0 done</p><form method='post' action='/add'><input name='text' placeholder='new task' required><button>Add</button></form><p>No tasks yet.</p>"
        },
        {
          "args": [
            [
              {
                "id": 1,
                "text": "milk",
                "done": false
              },
              {
                "id": 2,
                "text": "eggs",
                "done": true
              }
            ]
          ],
          "expect": "<!doctype html><meta charset='utf-8'><title>Todo</title><style>form{display:inline}li{margin:6px 0}</style><h1>Todo</h1><p>1 open, 1 done</p><form method='post' action='/add'><input name='text' placeholder='new task' required><button>Add</button></form><ul><li>milk <form method='post' action='/done'><input type='hidden' name='id' value='1'><button>Done</button></form> <form method='post' action='/remove'><input type='hidden' name='id' value='1'><button>Remove</button></form></li><li><s>eggs</s> <form method='post' action='/done'><input type='hidden' name='id' value='2'><button>Done</button></form> <form method='post' action='/remove'><input type='hidden' name='id' value='2'><button>Remove</button></form></li></ul>"
        }
      ]
    },
    {
      "title": "handle_add adds a task from the form",
      "description": "Create handle_add(tasks, form) in todo/ui_add.py. Use add_task from todo/add.py (already written, shown below). Each task is a dict {\"id\", \"text\", \"done\"}, for example {\"id\": 1, \"text\": \"milk\", \"done\": False}. form is a dict of the submitted text fields, for example {\"text\": \"milk\"}. Return the new list of tasks.\n1. return add_task(tasks, form[\"text\"])\n",
      "commit": "feat: add handle_add",
      "tests": [
        "tests/test_ui_add.py"
      ],
      "files": [
        "todo/__init__.py",
        "todo/ui_add.py"
      ],
      "context": [
        "todo/add.py"
      ],
      "function": "todo.ui_add:handle_add",
      "signature": "handle_add(tasks, form)",
      "examples": [
        {
          "args": [
            [],
            {
              "text": "milk"
            }
          ],
          "expect": [
            {
              "id": 1,
              "text": "milk",
              "done": false
            }
          ]
        },
        {
          "args": [
            [
              {
                "id": 1,
                "text": "milk",
                "done": false
              }
            ],
            {
              "text": " eggs "
            }
          ],
          "expect": [
            {
              "id": 1,
              "text": "milk",
              "done": false
            },
            {
              "id": 2,
              "text": "eggs",
              "done": false
            }
          ]
        },
        {
          "args": [
            [],
            {
              "text": "  "
            }
          ],
          "raises": "ValueError"
        },
        {
          "args": [
            [],
            {}
          ],
          "raises": "KeyError"
        }
      ]
    },
    {
      "title": "handle_done marks the task from the form as done",
      "description": "Create handle_done(tasks, form) in todo/ui_done.py. Use complete_task from todo/complete.py (already written, shown below). Each task is a dict {\"id\", \"text\", \"done\"}, for example {\"id\": 1, \"text\": \"milk\", \"done\": False}. form is a dict of the submitted text fields, for example {\"id\": \"1\"} (the id arrives as text). Return the new list of tasks.\n1. return complete_task(tasks, int(form[\"id\"]))\n",
      "commit": "feat: add handle_done",
      "tests": [
        "tests/test_ui_done.py"
      ],
      "files": [
        "todo/__init__.py",
        "todo/ui_done.py"
      ],
      "context": [
        "todo/complete.py"
      ],
      "function": "todo.ui_done:handle_done",
      "signature": "handle_done(tasks, form)",
      "examples": [
        {
          "args": [
            [
              {
                "id": 1,
                "text": "milk",
                "done": false
              }
            ],
            {
              "id": "1"
            }
          ],
          "expect": [
            {
              "id": 1,
              "text": "milk",
              "done": true
            }
          ]
        },
        {
          "args": [
            [
              {
                "id": 1,
                "text": "milk",
                "done": false
              }
            ],
            {
              "id": "9"
            }
          ],
          "raises": "KeyError"
        },
        {
          "args": [
            [
              {
                "id": 1,
                "text": "milk",
                "done": false
              }
            ],
            {
              "id": "x"
            }
          ],
          "raises": "ValueError"
        }
      ]
    },
    {
      "title": "handle_remove removes the task from the form",
      "description": "Create handle_remove(tasks, form) in todo/ui_remove.py. Use remove_task from todo/remove.py (already written, shown below). Each task is a dict {\"id\", \"text\", \"done\"}, for example {\"id\": 1, \"text\": \"milk\", \"done\": False}. form is a dict of the submitted text fields, for example {\"id\": \"1\"} (the id arrives as text). Return the new list of tasks.\n1. return remove_task(tasks, int(form[\"id\"]))\n",
      "commit": "feat: add handle_remove",
      "tests": [
        "tests/test_ui_remove.py"
      ],
      "files": [
        "todo/__init__.py",
        "todo/ui_remove.py"
      ],
      "context": [
        "todo/remove.py"
      ],
      "function": "todo.ui_remove:handle_remove",
      "signature": "handle_remove(tasks, form)",
      "examples": [
        {
          "args": [
            [
              {
                "id": 1,
                "text": "milk",
                "done": false
              },
              {
                "id": 2,
                "text": "eggs",
                "done": true
              }
            ],
            {
              "id": "1"
            }
          ],
          "expect": [
            {
              "id": 2,
              "text": "eggs",
              "done": true
            }
          ]
        },
        {
          "args": [
            [
              {
                "id": 1,
                "text": "milk",
                "done": false
              }
            ],
            {
              "id": "9"
            }
          ],
          "raises": "KeyError"
        },
        {
          "args": [
            [
              {
                "id": 1,
                "text": "milk",
                "done": false
              }
            ],
            {
              "id": "x"
            }
          ],
          "raises": "ValueError"
        }
      ]
    }
  ]
}
