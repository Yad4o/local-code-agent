# systemd USER service: runs the agent 24/7, restarts it if it crashes, starts it at boot.
#
# Install (adjust the two paths below if you cloned somewhere else):
#   mkdir -p ~/.config/systemd/user ~/agent-inbox
#   cp deploy/codeagent.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now codeagent
#   loginctl enable-linger "$USER"        # keep running when you are logged out / after reboot
#
# Watch it:   journalctl --user -u codeagent -f      (also: ~/agent-inbox/agent.log)
# Stop it:    systemctl --user stop codeagent         (finishes the current model call, then exits)

[Unit]
Description=codeagent: offline plan-driven coding agent
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/local-code-agent
ExecStart=%h/local-code-agent/.venv/bin/codeagent daemon --inbox %h/agent-inbox
Restart=on-failure
RestartSec=30
# be a polite background process on a laptop:
Nice=10
IOSchedulingClass=idle
CPUQuota=70%
# hard ceiling in case something escapes the agent's own limits (needs cgroup v2 delegation; ignored otherwise)
MemoryMax=4G
TimeoutStopSec=120

[Install]
WantedBy=default.target
